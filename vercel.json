{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @metricbase/client build",
  "outputDirectory": "client/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/stats",
      "destination": "https://metricbaseserver-production.up.railway.app/stats"
    },
    {
      "source": "/api/stats",
      "destination": "https://metricbaseserver-production.up.railway.app/api/stats"
    },
    {
      "source": "/api/x/link/callback",
      "destination": "https://metricbaseserver-production.up.railway.app/api/x/link/callback"
    },
    {
      "source": "/mission",
      "destination": "https://metricbaseserver-production.up.railway.app/mission"
    },
    {
      "source": "/mission/:path*",
      "destination": "https://metricbaseserver-production.up.railway.app/mission/:path*"
    },
    {
      "source": "/api/mission/:path*",
      "destination": "https://metricbaseserver-production.up.railway.app/api/mission/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}